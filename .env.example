# Copy to .env and fill in. Never commit .env.

# Superlinked SIE Serverless (all model calls)
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
SIE_CHAT_MODEL=Qwen/Qwen3.8-27B-FP8
SIE_COGNEE_MODEL=zai-org/GLM-5.3-Flash
EMBED_DIM=2560

# Claude fallback for chat jobs (P1)
ANTHROPIC_API_KEY=
LLM_BACKEND=sie

# Apify (P2)
APIFY_TOKEN=
UBEREATS_ACTOR=corent1robert/uber-eats-menu-scraper
DOORDASH_ACTOR=haketa/doordash-scraper
SCRAPE_CITY=San Francisco, CA
# Comma-separated store URLs. When set, the Actors scrape these stores instead of the city.
UBEREATS_STORE_URLS=
DOORDASH_STORE_URLS=

# SingleStore (P2)
SINGLESTORE_HOST=
SINGLESTORE_PORT=3306
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=mealmatch

# Cognee Cloud (P2). OPENAI_API_KEY only if SIE does not work as Cognee's LLM.
COGNEE_API_KEY=
COGNEE_SERVICE_URL=
OPENAI_API_KEY=

# Statsig and Firedrill (P3)
STATSIG_SERVER_KEY=
FIREDRILL_API_KEY=

# Modes
TOOL_MODE=fixtures          # fixtures | live | sim
MEMORY_BACKEND=memory       # memory | singlestore
DISTILLER=counting          # cognee | counting
RANKER=reranker             # reranker | price
