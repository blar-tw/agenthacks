# MealMatch env template. Copy to .env and fill in; .env is gitignored.
# Fill in the values after the "=" with no quotes or spaces.

# --- Superlinked SIE Serverless (P1, P2) — all model calls ---
# Keys start with sk-sie-. Base URL is the OpenAI-compatible root (the code adds /v1/...).
SIE_API_KEY=
SIE_BASE_URL=

# --- Fallback LLM (P1) — OpenAI-compatible gateway used instead of SIE for chat jobs ---
# OpenCode Zen: base https://opencode.ai/zen/v1 (keys from opencode.ai)
# OpenRouter:   base https://openrouter.ai/api/v1 (keys start with sk-or-)
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_MODEL=anthropic/claude-sonnet-5.5
# Hard cap on OpenRouter spend; the agent stops using it at this total (USD)
FALLBACK_LLM_BUDGET_USD=20
# sie = Qwen on SIE (default); fallback = the gateway above
LLM_PROVIDER=sie

# --- Apify (P2) — Uber Eats and DoorDash Actors ---
APIFY_TOKEN=

# --- SingleStore (P2) — source of truth and audit log ---
# Management API key (finds the workspace; not used for SQL)
SINGLESTORE_API_KEY=
# SQL connection (Starter workspace cluster-8f162394). Code builds the URL from these.
SINGLESTORE_HOST=
SINGLESTORE_PORT=
SINGLESTORE_DATABASE=
# From portal: workspace -> Connect (username shown there; reset password there if needed)
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=

# --- Cognee Cloud (P2) — learned soft preferences ---
COGNEE_API_KEY=
# Only if Cognee rejects the SIE endpoint (doc section 12 fallback)
OPENAI_API_KEY=

# --- Statsig (P3) — ranker flag, events, online evaluation ---
# Use the SERVER secret key (starts with secret-), not the client key.
STATSIG_SERVER_KEY=

# --- Firedrill (P3) — full-conversation tests ---
# Usually set by `firedrill login`; paste here only if the CLI asks for a key.
FIREDRILL_API_KEY=

# --- App settings (no secrets) ---
# live = Apify + Playwright, sim = Firedrill custom tool, fixtures = saved JSON
TOOL_MODE=fixtures

# --- Optional: LangSmith debug traces (drop if setup takes > 10 min) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
